# Copia este archivo a ".env" y llena los valores. NUNCA subas ".env" a Git.

# URL pública del sitio. En producción debe ser https. Se usa para los links de
# retorno de Mercado Pago, el webhook y los códigos QR.
PUBLIC_BASE_URL=http://localhost:8443

# --- Mercado Pago (credenciales de PRUEBA de la cuenta VENDEDORA de prueba) ---
# Panel de desarrolladores > Tu aplicación > Credenciales de prueba.
MP_ACCESS_TOKEN=
# Panel > Tu aplicación > Webhooks > Configurar notificaciones > Clave secreta.
# Hay una clave por pestaña (Modo de prueba y Modo productivo). Puedes poner varias separadas por
# coma, sin espacios: MP_WEBHOOK_SECRET=clavePrueba,claveProductiva
MP_WEBHOOK_SECRET=

# --- Control de acceso (escáner en /scan) ---
# PIN del staff (mínimo 6 caracteres) y secreto para firmar la sesión (mínimo 32).
STAFF_PIN=
SESSION_SECRET=

# --- Correo de boletos (opcional; sin esto los links se imprimen en la consola) ---
RESEND_API_KEY=
MAIL_FROM=Daneses Dorados <boletos@tu-dominio.com>

# --- Operación ---
# Ruta de la base de datos SQLite. En producción debe estar en un volumen persistente.
DATABASE_PATH=./data/daneses.db
# Capacidades usadas SOLO al crear la base la primera vez (luego: pnpm admin set-capacity ...).
CAPACITY_GENERAL=300
CAPACITY_VIP=100
RESERVATION_MINUTES=15
MAX_QTY_PER_ORDER=6
